#!/usr/bin/env bash
# Create, build, and launch docker-dev containers with optional host mounts.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

IMAGE="u2604dev"
IMAGE_TAG="latest"
WORKSPACE=""
MOUNT_CODEX=0
MOUNT_CLAUDE=0
DO_BUILD=0
DO_PULL=0
INTERACTIVE=1
NAME=""
EXTRA_ARGS=()

usage() {
  cat <<'EOF'
docker-dev — build and run a coding-ready dev container

Prerequisites: Docker installed; for GHCR images, authenticate with ghcr.io.

Options:
  -i, --image NAME     Image directory/name (u2204dev|u2404dev|u2604dev|u2604dev-opencode)
  -w, --workspace DIR  Host workspace to mount at /workspace (default: cwd)
  --mount-codex        Bind-mount $HOME/.codex → /root/.codex
  --mount-claude       Bind-mount $HOME/.claude → /root/.claude
  --build              docker build before run
  --pull               docker pull ghcr.io/luongnv89/IMAGE:latest before run
  -n, --name NAME      Container name (optional; enables docker start/stop hints)
  --no-interactive     Use flags only; skip prompts
  -h, --help           Show this help

Examples:
  ./scripts/docker-dev --image u2604dev --workspace "$PWD" --build
  ./scripts/docker-dev --mount-codex --mount-claude -w ~/projects/myapp

Inside the container:
  - Shell: zsh (Starship + Oh My Zsh)
  - Tools: git, vim, opencode, pi (+ pi-extensions), Claude/Codex via mounts or npm globals
  - Attach: docker exec -it <name> zsh   (if you used --name)
EOF
}

die() {
  echo "✗ $*" >&2
  exit 1
}

require_dir() {
  local label="$1"
  local path="$2"
  if [ -z "$path" ]; then
    die "${label} path is empty"
  fi
  if [ ! -d "$path" ]; then
    die "${label} not found: ${path} (create it or fix the path)"
  fi
}

prompt_yes_no() {
  local prompt="$1"
  local default="${2:-y}"
  if [ "$INTERACTIVE" -eq 0 ]; then
    return 0
  fi
  local hint="[Y/n]"
  [ "$default" = "n" ] && hint="[y/N]"
  read -r -p "${prompt} ${hint} " ans || true
  ans="${ans:-$default}"
  case "$ans" in
    y|Y|yes|YES) return 0 ;;
    *) return 1 ;;
  esac
}

while [ $# -gt 0 ]; do
  case "$1" in
    -i|--image) IMAGE="$2"; shift 2 ;;
    -w|--workspace) WORKSPACE="$2"; shift 2 ;;
    --mount-codex) MOUNT_CODEX=1; shift ;;
    --mount-claude) MOUNT_CLAUDE=1; shift ;;
    --build) DO_BUILD=1; shift ;;
    --pull) DO_PULL=1; shift ;;
    -n|--name) NAME="$2"; shift 2 ;;
    --no-interactive) INTERACTIVE=0; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; EXTRA_ARGS+=("$@"); break ;;
    *) die "Unknown option: $1 (use --help)" ;;
  esac
done

case "$IMAGE" in
  u2204dev|u2404dev|u2604dev|u2604dev-opencode) ;;
  *) die "Unsupported image: ${IMAGE}" ;;
esac

if [ "$INTERACTIVE" -eq 1 ] && [ -z "$WORKSPACE" ] && [ "$MOUNT_CODEX" -eq 0 ] && [ "$MOUNT_CLAUDE" -eq 0 ]; then
  echo "◆ docker-dev setup"
  echo "  Image: ${IMAGE}"
  prompt_yes_no "Mount Codex config from \$HOME/.codex?" y && MOUNT_CODEX=1 || true
  prompt_yes_no "Mount Claude Code config from \$HOME/.claude?" y && MOUNT_CLAUDE=1 || true
  if [ -z "$WORKSPACE" ]; then
    read -r -p "Workspace directory [${PWD}]: " ws || true
    WORKSPACE="${ws:-$PWD}"
  fi
  prompt_yes_no "Build image locally before run?" y && DO_BUILD=1 || true
fi

WORKSPACE="${WORKSPACE:-$PWD}"
require_dir "Workspace" "$WORKSPACE"

LOCAL_TAG="${IMAGE}:${IMAGE_TAG}"
CONTEXT="${ROOT_DIR}/${IMAGE}"
DOCKERFILE="${CONTEXT}/Dockerfile"

if [ ! -f "$DOCKERFILE" ]; then
  die "Dockerfile not found: ${DOCKERFILE}"
fi

if [ "$DO_PULL" -eq 1 ]; then
  echo "● Pulling ghcr.io/luongnv89/${IMAGE}:latest ..."
  docker pull "ghcr.io/luongnv89/${IMAGE}:latest" || die "Pull failed"
  LOCAL_TAG="ghcr.io/luongnv89/${IMAGE}:latest"
fi

if [ "$DO_BUILD" -eq 1 ]; then
  echo "● Building ${LOCAL_TAG} ..."
  if [ "$IMAGE" = "u2604dev-opencode" ]; then
    echo "  Building base u2604dev:latest first..."
    docker build -t u2604dev:latest -f "${ROOT_DIR}/u2604dev/Dockerfile" "${ROOT_DIR}/u2604dev" \
      || die "Base image build failed"
  fi
  BUILD_CONTEXT="$ROOT_DIR"
  if [ "$IMAGE" = "u2604dev-opencode" ]; then
    BUILD_CONTEXT="$ROOT_DIR"
  fi
  if ! docker build -t "$LOCAL_TAG" -f "$DOCKERFILE" "$BUILD_CONTEXT"; then
    die "Image build failed — no container was started"
  fi
fi

VOLUMES=(-v "${WORKSPACE}:/workspace")

if [ "$MOUNT_CODEX" -eq 1 ]; then
  CODEX_HOME="${HOME}/.codex"
  if [ -d "$CODEX_HOME" ]; then
    VOLUMES+=(-v "${CODEX_HOME}:/root/.codex")
  else
    die "Codex config directory missing: ${CODEX_HOME}"
  fi
fi

if [ "$MOUNT_CLAUDE" -eq 1 ]; then
  CLAUDE_HOME="${HOME}/.claude"
  if [ -d "$CLAUDE_HOME" ]; then
    VOLUMES+=(-v "${CLAUDE_HOME}:/root/.claude")
  else
    die "Claude config directory missing: ${CLAUDE_HOME}"
  fi
fi

RUN_ARGS=(docker run --rm -it)
if [ -n "$NAME" ]; then
  RUN_ARGS=(docker run -it --name "$NAME")
fi
RUN_ARGS+=("${VOLUMES[@]}" -w /workspace "$LOCAL_TAG" zsh)

echo ""
echo "◆ Starting container"
echo "  Image:      ${LOCAL_TAG}"
echo "  Workspace:  ${WORKSPACE} → /workspace"
[ "$MOUNT_CODEX" -eq 1 ] && echo "  Codex:      \$HOME/.codex → /root/.codex"
[ "$MOUNT_CLAUDE" -eq 1 ] && echo "  Claude:     \$HOME/.claude → /root/.claude"
echo ""
echo "  Run:        ${RUN_ARGS[*]}"
echo "  Shell:      zsh inside container (exit to leave)"
if [ -n "$NAME" ]; then
  echo "  Re-attach:  docker exec -it ${NAME} zsh"
  echo "  Stop:       docker stop ${NAME} && docker rm ${NAME}"
fi
echo ""

exec "${RUN_ARGS[@]}"