#!/usr/bin/env bash
# cdev — coding dev containers (docker-dev project)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLI_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
LIB_DIR="${CLI_ROOT}/lib"

# shellcheck source=../lib/common.sh
source "${LIB_DIR}/common.sh"

if [ -z "${CDEV_VERSION:-}" ]; then
  if [ -f "${CLI_ROOT}/VERSION" ]; then
    CDEV_VERSION="$(tr -d '[:space:]' < "${CLI_ROOT}/VERSION")"
  else
    CDEV_VERSION="0.0.0"
  fi
fi

GLOBAL_VERBOSE=0
GLOBAL_QUIET=0
GLOBAL_NO_COLOR=0
GLOBAL_REPO=""

show_root_help() {
  cat <<EOF
cdev — build and run coding-ready dev containers

Version: ${CDEV_VERSION}

Usage:
  cdev <command> [options]
  cdev run [options]          Start interactive container (default workflow)
  cdev build [options]        Build image locally
  cdev list [--format json]   List image names
  cdev config [--format json] Show paths and repo root

Global options:
  -h, --help           Show help
  --version            Print version
  -v, --verbose        Verbose logs (stderr)
  -q, --quiet          Minimal output
  --no-color           Disable color hints
  --repo PATH          Path to docker-dev git checkout

Environment:
  CDEV_REPO / DOCKER_DEV_REPO   Repository root (Dockerfiles)
  NO_COLOR                      Disable color (standard)

Install (cdev + herdr):
  curl -fsSL https://raw.githubusercontent.com/luongnv89/docker-dev/main/install.sh | bash

Examples:
  cdev run --image u2604dev --workspace "\$PWD" --build
  cdev run --mount-codex --mount-claude -w ~/projects/app
  cdev build --image u2404dev
  cdev list --format json
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)
      show_root_help
      exit 0
      ;;
    --version)
      echo "cdev ${CDEV_VERSION}"
      exit 0
      ;;
    -v|--verbose) GLOBAL_VERBOSE=1; shift ;;
    -q|--quiet) GLOBAL_QUIET=1; shift ;;
    --no-color) GLOBAL_NO_COLOR=1; shift ;;
    --repo) GLOBAL_REPO="$2"; shift 2 ;;
    run|build|list|config)
      break
      ;;
    *)
      if [ "${1#-}" != "$1" ]; then
        usage_error "Unknown global option: $1 (try cdev --help)"
      fi
      break
      ;;
  esac
done

export DOCKER_DEV_VERBOSE="$GLOBAL_VERBOSE"
export DOCKER_DEV_QUIET="$GLOBAL_QUIET"
export DOCKER_DEV_NO_COLOR="$GLOBAL_NO_COLOR"
[ -n "$GLOBAL_REPO" ] && export DOCKER_DEV_REPO="$GLOBAL_REPO"

CMD="${1:-run}"
if [ $# -gt 0 ]; then
  shift
fi

REPO_ROOT="$(docker_dev_resolve_repo_root "$CLI_ROOT")"

# shellcheck source=../lib/build.sh
source "${LIB_DIR}/build.sh"
# shellcheck source=../lib/run.sh
source "${LIB_DIR}/run.sh"
# shellcheck source=../lib/list.sh
source "${LIB_DIR}/list.sh"
# shellcheck source=../lib/config.sh
source "${LIB_DIR}/config.sh"

case "$CMD" in
  run) docker_dev_cmd_run "$REPO_ROOT" "$@" ;;
  build) docker_dev_cmd_build "$REPO_ROOT" "$@" ;;
  list) docker_dev_cmd_list "$@" ;;
  config) docker_dev_cmd_config "$REPO_ROOT" "$@" ;;
  *)
    usage_error "Unknown command: ${CMD}. Try: run, build, list, config"
    ;;
esac